[Unit]
Description=LiteRT-LM server (Gemma 4 E2B on the NPU)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=arduino
# Qualcomm's NPU libraries: the board side finds them through LD_LIBRARY_PATH, the NPU side through ADSP_LIBRARY_PATH.
Environment=LD_LIBRARY_PATH=/home/arduino/.litert-lm/npu ADSP_LIBRARY_PATH=/home/arduino/.litert-lm/npu
ExecStart=/home/arduino/.local/bin/litert-lm-npu serve --host 0.0.0.0 --port 9379
# Loads the model at start, so the first real query doesn't wait for the load.
ExecStartPost=/usr/bin/curl -s -o /dev/null --retry 30 --retry-connrefused --retry-delay 1 http://127.0.0.1:9379/v1/chat/completions -H 'Content-Type: application/json' -d '{"model":"gemma-4-e2b","messages":[{"role":"user","content":"hi"}]}'
Restart=always
RestartSec=5
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
